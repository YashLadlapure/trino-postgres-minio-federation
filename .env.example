# =============================================================================
# Environment Variables — copy to .env and adjust as needed
# NEVER commit .env to version control (it's in .gitignore)
# =============================================================================

# PostgreSQL
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=appdb

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Trino (no auth in local mode — web UI at http://localhost:8080)
# TRINO_PORT=8080
